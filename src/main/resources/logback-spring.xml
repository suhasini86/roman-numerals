<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Log pattern with traceId and spanId for distributed tracing -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-}%X{trace_id:-}] [spanId=%X{spanId:-}%X{span_id:-}] - %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Application logs at DEBUG level -->
    <logger name="com.adobe.aem" level="DEBUG"/>

    <!-- OpenTelemetry logs at INFO level (suppresses DEBUG noise) -->
    <logger name="io.opentelemetry" level="INFO"/>

    <!-- Micrometer logs at INFO level -->
    <logger name="io.micrometer" level="INFO"/>

    <!-- Spring Framework logs at INFO level (reduces verbosity) -->
    <logger name="org.springframework" level="INFO"/>

    <!-- Root logger at INFO level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
